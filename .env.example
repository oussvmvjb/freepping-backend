# ─────────────────────────────────────────────────────────────────────────────
# FREPPING Backend — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
#
# Copy this file to .env and fill in your values.
# .env is gitignored — NEVER commit .env or real secrets.
#
# ─── LOCAL DEVELOPMENT EXAMPLE ───────────────────────────────────────────────
#
#   APP_ENV=development
#   DEBUG=true
#   DATABASE_URL=postgresql://postgres:root@127.0.0.1:5432/db_freepping
#   FRONTEND_URL=http://localhost:4200
#   CORS_ORIGINS=["http://localhost:4200"]
#   JWT_SECRET_KEY=dev-secret-key-change-this-in-production-32chars
#
# ─── PRODUCTION (Render) EXAMPLE ─────────────────────────────────────────────
#
#   APP_ENV=production
#   DEBUG=false
#   DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
#   FRONTEND_URL=https://freepping.netlify.app
#   CORS_ORIGINS=["https://freepping.netlify.app"]
#   JWT_SECRET_KEY=<generate: openssl rand -hex 32>
#
# ─────────────────────────────────────────────────────────────────────────────

PROJECT_NAME="FREPPING Backend"
API_V1_STR="/api/v1"
APP_ENV=development
DEBUG=true

# ── Database ──────────────────────────────────────────────────────────────────
# Set DATABASE_URL directly (recommended) OR use the discrete DB_* fields below.
#
# LOCAL:
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/db_freepping
#
# PRODUCTION (Supabase Session Pooler — use this on Render):
# DATABASE_URL=postgresql://postgres.hvbixuqzrtuijnxnjiwm:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Discrete fields (used as fallback if DATABASE_URL is NOT set):
DB_USER=postgres
DB_PASSWORD=YOUR_LOCAL_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=db_freepping

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
# LOCAL:
FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=["http://localhost:4200"]
#
# PRODUCTION (set in Render environment variables dashboard):
# FRONTEND_URL=https://freepping.netlify.app
# CORS_ORIGINS=["https://freepping.netlify.app"]

# ── JWT ───────────────────────────────────────────────────────────────────────
# LOCAL: use any dev string
# PRODUCTION: generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-in-production-super-secret-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Rate Limiting (per minute) ────────────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=30

# ── Cache TTLs (seconds) ──────────────────────────────────────────────────────
CACHE_TTL_PRODUCT_DETAIL=300
CACHE_TTL_PRODUCT_LIST=120
CACHE_TTL_CATEGORIES=600

# ── Seed / Initial Admin (development only) ───────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-pass
