PROJECT_NAME="FREPPING Backend"
API_V1_STR="/api/v1"
APP_ENV="development"
DEBUG=true

# Database Configuration (Supabase PostgreSQL)
# Example connection string for Supabase:
# Note: On Render, configure DATABASE_URL in the Environment Variables dashboard.
DATABASE_URL=postgresql://postgres:oussamajb009.@db.hvbixuqzrtuijnxnjiwm.supabase.co:5432/postgres

# Alternatively, discrete parameters (used as fallback if DATABASE_URL is not set):
DB_USER=postgres
DB_PASSWORD=oussamajb009.
DB_HOST=db.hvbixuqzrtuijnxnjiwm.supabase.co
DB_PORT=5432
DB_NAME=postgres

# Redis Configuration (Optional / Render Redis / Upstash)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379/0

# CORS Configuration
FRONTEND_URL="http://localhost:4200"
CORS_ORIGINS=["http://localhost:4200"]

# JWT Authentication Configuration
JWT_SECRET_KEY=change-this-in-production-super-secret-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting (per minute)
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=30

# Cache TTLs (in seconds)
CACHE_TTL_PRODUCT_DETAIL=300
CACHE_TTL_PRODUCT_LIST=120
CACHE_TTL_CATEGORIES=600

# Seed / Initial Admin Setup (development only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-pass
